{
  "name": "baby-care-supabase-local",
  "private": true,
  "scripts": {
    "supabase:start": "supabase start >/dev/null",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "test:supabase:db": "supabase test db",
    "test:supabase:context": "bash scripts/test-supabase-context.sh",
    "test:supabase:api-db": "bash scripts/test-api-postgres-authorization.sh",
