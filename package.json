    "test:supabase": "npm run supabase:start && npm run supabase:reset && npm run test:supabase:db && npm run test:supabase:context && npm run test:supabase:api-db && npm run test:supabase:http"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
