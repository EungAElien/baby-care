# Local, non-secret defaults. Copy this file to .env only when needed.
BABY_CARE_ENVIRONMENT=local
BABY_CARE_LOG_LEVEL=INFO
BABY_CARE_HOST=127.0.0.1
BABY_CARE_PORT=8080

# B-03 provides the schema and runtime authorization adapter. Keep real values local and use a
# deployment-specific login that can SET ROLE baby_app; never use the migration login here.
# BABY_CARE_DATABASE_URL=postgresql://user:password@host:5432/database
# BABY_CARE_SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
# BABY_CARE_SUPABASE_JWT_AUDIENCE=authenticated
# BABY_CARE_SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
# BABY_CARE_SUPABASE_JWT_ALGORITHMS=ES256,RS256
# BABY_CARE_SUPABASE_URL=https://project-ref.supabase.co
# BABY_CARE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# BABY_CARE_REAUTHENTICATION_PROOF_SECRET=<at-least-32-random-bytes>
BABY_CARE_INVITE_BASE_URL=http://127.0.0.1:3000/invite

# Keep production child-data processing disabled until an approved guardian-verification method,
# evidence policy, and operational configuration are all in place. OWNER or email OTP is not proof.
BABY_CARE_CHILD_DATA_PRODUCTION_ENABLED=false

# Real user text must not be sent externally until the separate processing gate is verified.
BABY_CARE_EXTERNAL_NORMALIZATION_ENABLED=false
