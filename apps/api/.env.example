# Local, non-secret defaults. Copy this file to .env only when needed.
BABY_CARE_ENVIRONMENT=local
BABY_CARE_LOG_LEVEL=INFO
BABY_CARE_HOST=127.0.0.1
BABY_CARE_PORT=8080

# B-03 provides the schema and runtime authorization adapter. Keep real values local and use a
# deployment-specific login that can SET ROLE baby_app; never use the migration login here.
# BABY_CARE_DATABASE_URL=postgresql://user:password@host:5432/database
# BABY_CARE_SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
# BABY_CARE_SUPABASE_JWT_AUDIENCE=authenticated
# BABY_CARE_SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
# BABY_CARE_SUPABASE_JWT_ALGORITHMS=ES256,RS256
# BABY_CARE_SUPABASE_URL=https://project-ref.supabase.co
# BABY_CARE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Server-only Storage credential. Never expose this value to the browser or NEXT_PUBLIC variables.
# BABY_CARE_SUPABASE_SECRET_KEY=<secret-key-or-legacy-service-role-key>
# Optional direct Storage hostname recommended for TUS on hosted Supabase.
# BABY_CARE_SUPABASE_STORAGE_URL=https://project-ref.storage.supabase.co
# BABY_CARE_REAUTHENTICATION_PROOF_SECRET=<at-least-32-random-bytes>
BABY_CARE_INVITE_BASE_URL=http://127.0.0.1:3000/invite

# Keep production child-data processing disabled until an approved guardian-verification method,
# evidence policy, and operational configuration are all in place. OWNER or email OTP is not proof.
BABY_CARE_CHILD_DATA_PRODUCTION_ENABLED=false

# Real user text must not be sent externally until the separate processing gate is verified.
BABY_CARE_EXTERNAL_NORMALIZATION_ENABLED=false
# The normalizer is available only when the explicit gate is true and this server-side key is set.
BABY_CARE_OPENAI_API_KEY=
BABY_CARE_OPENAI_ORGANIZATION=
BABY_CARE_OPENAI_PROJECT=
BABY_CARE_NORMALIZATION_TIMEOUT_SECONDS=20
BABY_CARE_NORMALIZATION_LEASE_SECONDS=30

# The container copies these exact binaries from the digest-pinned FFmpeg 7.1.1 image.
BABY_CARE_AUDIO_FFMPEG_PATH=/usr/local/bin/ffmpeg
BABY_CARE_AUDIO_FFPROBE_PATH=/usr/local/bin/ffprobe
BABY_CARE_AUDIO_FFMPEG_VERSION_PREFIX=ffmpeg version 7.1.1
BABY_CARE_AUDIO_DECODE_CONCURRENCY=2

# Dedicated V1 B model profile only. The normal API keeps this disabled. The model bundle and
# prepared M2D source must already exist below one read-only server-owned root before startup.
BABY_CARE_M2D_ENABLED=false
# BABY_CARE_M2D_ALLOWED_ROOT=/opt/baby-care-runtime
# BABY_CARE_M2D_BUNDLE_PATH=/opt/baby-care-runtime/model/selected
# BABY_CARE_M2D_SOURCE_PATH=/opt/baby-care-runtime/m2d-source
# BABY_CARE_M2D_FFMPEG_PATH=/usr/local/bin/ffmpeg
