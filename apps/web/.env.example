# Only public browser configuration. Never put service_role, DB, or LLM secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# A-03 consent grants and invite acceptance stay disabled until the approved
# public policy text AND its exact version are supplied for each scope.
# Never put personal data or secrets in these browser-visible values.
# NEXT_PUBLIC_POLICY_SHARED_USE_VERSION=
# NEXT_PUBLIC_POLICY_SHARED_USE_TEXT=
# NEXT_PUBLIC_POLICY_SERVICE_PROCESSING_VERSION=
# NEXT_PUBLIC_POLICY_SERVICE_PROCESSING_TEXT=
# NEXT_PUBLIC_POLICY_AUDIO_RETENTION_VERSION=
# NEXT_PUBLIC_POLICY_AUDIO_RETENTION_TEXT=
# NEXT_PUBLIC_POLICY_BABY_TRAINING_VERSION=
# NEXT_PUBLIC_POLICY_BABY_TRAINING_TEXT=
# NEXT_PUBLIC_POLICY_CONTRIBUTOR_TRAINING_VERSION=
# NEXT_PUBLIC_POLICY_CONTRIBUTOR_TRAINING_TEXT=

# Dev/preview only — turns on the SC01~SC10 mock session and screens
# (/login, /babies/*). Leave unset for production builds; keep it out of
# committed .env files and set it only in your local .env.local.
NEXT_PUBLIC_ENABLE_MOCK_NAV=true
